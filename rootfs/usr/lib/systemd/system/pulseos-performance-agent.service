[Unit]
Description=PulseOS native reversible gaming performance daemon
After=tuned.service tuned-ppd.service
Wants=tuned.service

[Service]
Type=simple
ExecStart=/usr/libexec/pulseos/pulse-perfd
Restart=always
RestartSec=2
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/pulseos

[Install]
WantedBy=multi-user.target
