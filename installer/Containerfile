ARG FEDORA_VERSION=44
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

ARG FEDORA_VERSION=44
ARG PULSEOS_SOURCE_REF=localhost/pulse-os:dev
ARG PULSEOS_UPDATE_REF=ghcr.io/lololegeek/pulse-os:edge

RUN dnf5 -y install \
      anaconda anaconda-install-img-deps anaconda-dracut \
      dracut-config-generic dracut-network \
      net-tools squashfs-tools xorriso \
      grub2-efi-x64-cdboot shim-x64 \
      plymouth default-fonts-core-sans default-fonts-other-sans \
      google-noto-sans-cjk-fonts jq && \
    dnf5 clean all

# Fedora 43+ installer-image contract.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi || true
RUN mkdir -p /var/mnt

# Keep this as a plain printf rather than a Dockerfile heredoc. GitHub's
# Ubuntu 24.04 runner currently ships Podman 4.9, whose builder does not
# reliably parse heredoc RUN bodies in this Containerfile.
RUN mkdir -p /usr/lib/image-builder/bootc && \
    printf '%s\n' \
      'label: "PulseOS-Installer"' \
      'grub2:' \
      '  default: "Install PulseOS Gaming"' \
      '  timeout: 5' \
      '  entries:' \
      '    - name: "Install PulseOS Gaming"' \
      '      linux: "/images/pxeboot/vmlinuz inst.stage2=hd:LABEL=PulseOS-Installer console=tty0 inst.graphical rhgb quiet"' \
      '      initrd: "/images/pxeboot/initrd.img"' \
      '    - name: "Install PulseOS (basic graphics)"' \
      '      linux: "/images/pxeboot/vmlinuz inst.stage2=hd:LABEL=PulseOS-Installer console=tty0 inst.graphical nomodeset"' \
      '      initrd: "/images/pxeboot/initrd.img"' \
      > /usr/lib/image-builder/bootc/iso.yaml

# The payload image is embedded by image-builder. The installed system tracks a
# publishable OCI reference so bootc can perform atomic upgrades afterwards.
RUN printf 'bootc --source-imgref registry:%s --target-imgref %s\n' \
      "$PULSEOS_SOURCE_REF" "$PULSEOS_UPDATE_REF" \
      > /usr/share/anaconda/interactive-defaults.ks

# Minimum live Anaconda setup used by the current image-builder contract.
RUN echo 'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda' >> /etc/passwd && \
    echo 'install::14438:0:99999:7:::' >> /etc/shadow && \
    passwd -d root && \
    mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -sf /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator && \
    ln -sf /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d && \
    printf '[Login]\nReserveVT=2\n' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir "$(realpath /root)" 2>/dev/null || true; \
    kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version' | head -1)"; \
    DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
      --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf
