[Unit]
Description=PulseOS latency-aware sched_ext scheduler (scx_lavd)
Documentation=https://sched-ext.com/docs/scheds/rust/scx_lavd
ConditionPathExists=/sys/kernel/sched_ext
ConditionPathExists=/usr/bin/scx_lavd
After=multi-user.target

[Service]
Type=simple
# Autopilot is intentionally the global default: it enters performance mode at
# high load and does not waste power or thermals while the machine is idle.
ExecStart=/usr/bin/scx_lavd --autopilot
Restart=on-failure
RestartSec=1
Nice=-10
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
