#!/usr/bin/env bash
set -u

ok=0
warn=0
pass() { printf '[ OK ] %s\n' "$*"; ok=$((ok+1)); }
warning() { printf '[WARN] %s\n' "$*"; warn=$((warn+1)); }

printf 'PulseOS diagnostics\n===================\n'
printf 'OS: '
grep '^PRETTY_NAME=' /etc/os-release | cut -d= -f2- | tr -d '"'
printf 'Kernel: %s\n' "$(uname -r)"
printf 'CPU: %s\n' "$(lscpu | awk -F: '/Model name/ {sub(/^ +/,"",$2); print $2; exit}')"
printf 'GPU(s):\n'
lspci -nn | grep -Ei 'VGA|3D|Display' || true
printf '\n'

if [[ -e /dev/ntsync ]]; then
  pass '/dev/ntsync is available'
else
  warning 'ntsync device is missing; Proton may use another sync path'
fi

if [[ -d /sys/kernel/sched_ext ]]; then
  pass 'kernel exposes sched_ext'
else
  warning 'kernel does not expose sched_ext'
fi

if command -v scx_lavd >/dev/null; then
  pass 'scx_lavd installed'
else
  warning 'scx_lavd missing'
fi

if systemctl --quiet is-active pulseos-scx.service; then
  pass 'scx_lavd service active'
else
  warning 'scx_lavd service inactive/fell back to normal scheduler'
fi

if command -v gamescope >/dev/null; then
  pass 'Gamescope installed'
else
  warning 'Gamescope missing'
fi

if command -v steam >/dev/null; then
  pass 'Steam installed'
else
  warning 'Steam missing'
fi

if command -v gamemoded >/dev/null; then
  pass 'GameMode installed'
else
  warning 'GameMode missing'
fi

if command -v vulkaninfo >/dev/null && vulkaninfo --summary >/tmp/pulseos-vulkan.txt 2>/dev/null; then
  pass 'Vulkan initializes'
else
  warning 'Vulkan initialization failed'
fi

if command -v systemd-detect-virt >/dev/null && [[ "$(systemd-detect-virt 2>/dev/null || true)" != "none" ]]; then
  warning 'running in a VM; gaming performance results are not representative'
fi

if grep -qw 'mitigations=off' /proc/cmdline; then
  warning 'mitigations=off was supplied externally; PulseOS does not recommend this'
else
  pass 'CPU security mitigations were not globally disabled'
fi

printf '\nSummary: %d checks OK, %d warnings\n' "$ok" "$warn"
printf 'Saved Vulkan summary: /tmp/pulseos-vulkan.txt (when available)\n'
